{
  "name": "@restaurant/print-agent",
  "version": "1.0.0",
  "type": "module",
  "description": "Print agent for automatic thermal printing of restaurant orders",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsc && node dist/index.js",
    "start:dev": "tsc && cross-env AGENT_API_URL=http://localhost:3000 node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "version:inject": "node scripts/inject-version.js",
    "bundle": "esbuild dist/index.js --bundle --platform=node --format=cjs --outfile=dist/bundle.cjs --external:node-thermal-printer --external:keytar",
    "package": "npm run version:inject && npm run build && npm run bundle && pkg dist/bundle.cjs --targets node20-win-x64 --output build/print-agent.exe --config package.json"
  },
  "pkg": {
    "assets": ["node_modules/keytar/build/Release/keytar.node"],
    "outputPath": "build"
  },
  "dependencies": {
    "keytar": "^7.9.0",
    "node-thermal-printer": "^4.4.3",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@yao-pkg/pkg": "^5.15.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.8.4",
    "typescript": "^5.5.0",
    "vitest": "^4.1.9"
  }
}
