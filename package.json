{
  "name": "@restaurant/print-agent",
  "version": "1.0.0",
  "type": "module",
  "description": "Print agent for automatic thermal printing of restaurant orders",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsc && node dist/index.js",
    "start:dev": "tsc && cross-env AGENT_API_URL=http://localhost:3000 node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "version:inject": "node scripts/inject-version.js",
    "bundle": "esbuild dist/index.js --bundle --platform=node --format=cjs --outfile=dist/bundle.cjs --external:node-thermal-printer --external:keytar",
    "package": "npm run version:inject && npm run build && npm run bundle && pkg dist/bundle.cjs --targets node20-win-x64 --output build/print-agent.exe --config package.json",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=cjs --external:electron --external:electron-updater --external:keytar --external:node-thermal-printer --outfile=dist-electron/main.cjs",
    "build:preload": "esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
    "build:renderer": "esbuild renderer/app.ts --bundle --platform=browser --outfile=dist-electron/renderer/app.js",
    "build:assets": "node -e \"const fs=require('fs');fs.mkdirSync('dist-electron/renderer',{recursive:true});fs.copyFileSync('renderer/index.html','dist-electron/renderer/index.html');fs.copyFileSync('renderer/styles.css','dist-electron/renderer/styles.css')\"",
    "electron:build": "npm run build:electron && npm run build:preload && npm run build:renderer && npm run build:assets",
    "electron:dev": "npm run electron:build && electron dist-electron/main.cjs",
    "electron:dist": "npm run electron:build && electron-builder",
    "postinstall": "electron-rebuild || exit 0"
  },
  "pkg": {
    "assets": [
      "node_modules/keytar/build/Release/keytar.node"
    ],
    "outputPath": "build"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "keytar": "^7.9.0",
    "node-thermal-printer": "^4.4.3",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@yao-pkg/pkg": "^5.15.0",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.8.4",
    "typescript": "^5.5.0",
    "vitest": "^4.1.9"
  }
}
